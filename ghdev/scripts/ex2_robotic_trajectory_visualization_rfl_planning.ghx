                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load

if load:
    data = json_load(fp=file_path)
    building_plan = data["building_plan"]
    assembly = data["assembly"]
    ghenv.Component.Message = None

else:
    ghenv.Component.Message = "Toggle Design Info"
</item>
