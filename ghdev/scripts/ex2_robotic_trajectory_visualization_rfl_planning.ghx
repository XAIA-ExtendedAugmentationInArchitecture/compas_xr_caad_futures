              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_xr.project import ProjectManager
from compas_timber.planning.sequencer import BuildingPlan
from compas_rhino.conversions import plane_to_compas_frame

last_built_index = None
step_locations = None
built_human = None
unbuilt_human = None
built_robot = None
unbuilt_robot = None

def convert_part_list_geo(list):
    empty_list = []
    for item in list:
        needed = item.attributes["shape"]
        empty_list.append(needed)
    return empty_list

if "project_data" not in globals():
    project_data = {}

if not (config_filepath):
    ghenv.Component.Message = "Missing Config"

elif not (project_name):
    ghenv.Component.Message = "Missing Project Name"

elif not (assembly):
    ghenv.Component.Message = "Missing Assembly"

else:
    pm = ProjectManager(config_filepath)
    ghenv.Component.Message = None
    
    if visualize:
        last_built_index, step_locations, built_human, unbuilt_human, built_robot, unbuilt_robot = pm.visualize_project_state(assembly, project_name)
        project_data["last_built_index"] = last_built_index
        project_data["step_locations"] = step_locations
        project_data["built_human"] = built_human
        project_data["unbuilt_human"] = unbuilt_human
        project_data["built_robot"] = built_robot
        project_data["unbuilt_robot"] = unbuilt_robot

if project_data:
    last_built_index = project_data["last_built_index"]
    step_locations = project_data["step_locations"]
    built_human = convert_part_list_geo(project_data["built_human"])
    unbuilt_human = convert_part_list_geo(project_data["unbuilt_human"])
    built_robot = convert_part_list_geo(project_data["built_robot"])
    unbuilt_robot = convert_part_list_geo(project_data["unbuilt_robot"])
    all_built_objects = built_human + built_robot</item>
