            <chunk name="Object" index="486">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
Calculate placement of a part.
"""
from ghpythonlib.componentbase import executingcomponent as component
from scriptcontext import sticky as st

#from compas.artists import Artist
from compas.scene import Scene
from compas.geometry import Frame
from compas.geometry import Transformation
from compas_rhino.conversions import plane_to_compas_frame
from compas_fab.ghpython.components import create_id
from compas_fab.robots import PlanningScene
from compas.geometry import scale_vector, add_vectors

class PlacePart(component):
    def RunScript(self, robot, group, current_config, approach_pick_config, place_plane, approach_distance, exit_dist, flip_offset_plane, update):
        self.Message = ""
        if not place_plane:
            raise Exception("No place plane defined")

        place_config = None
        approach_place_config = None
        exit_safe_config = None

        if (update or not place_config or not approach_place_config or not current_config) and robot and robot.client and robot.client.is_connected:
            scene = PlanningScene(robot)
            scene.remove_collision_mesh("parts")
            geo_scene = Scene()

            place_frame = plane_to_compas_frame(place_plane)
            approach_place_frame = place_frame.copy()
            if approach_distance &gt; 0:
                approach_place_frame = self._offset_approach_frame(place_frame, approach_distance, flip_offset_plane)

            exit_frame = robot.forward_kinematics(current_config, group, options=dict(solver='model'))
            if exit_frame == None:
                raise Exception ("Could not solve FK to get the Exit Frame from the current_config as needed")
            exit_frame_copy = exit_frame.copy()
            if exit_dist &gt; 0:
                #TODO: CHECK THE FLIP OFFSET PLANE.
                exit_safe_frame = self._offset_approach_frame(exit_frame, exit_dist, flip_offset_plane)#TODO: Really check this.

            try:
                #TODO: I changed this a lot below.
                exit_safe_config = robot.inverse_kinematics(exit_safe_frame, current_config, group)
                # approach_place_config = robot.inverse_kinematics(approach_place_frame, place_config, group)
            except:
                raise Exception("Could not solve IK solution for Exit safe config")
            try:
                #TODO: I changed this a lot below.
                approach_place_config = robot.inverse_kinematics(approach_place_frame, approach_pick_config, group)
                # approach_place_config = robot.inverse_kinematics(approach_place_frame, place_config, group)
            except:
                raise Exception("Could not solve IK solution for approach place config")
            try:
                #TODO: I changed this a lot below.
                place_config = robot.inverse_kinematics(place_frame, approach_place_config, group)
                # place_config = robot.inverse_kinematics(place_frame, approach_pick_config, group)
            except:
                raise Exception("Could solve IK solution for place config")

        self.Message = "Found place configurations\nusing {:.2f}m approach distance".format(approach_distance)
        return current_config, exit_safe_config, approach_place_config, place_config
    
    def _offset_approach_frame(self, frame, approach_distance, flip_offset_plane):
        
        frame = frame.copy()
        offset_frame = frame.copy()
            
        if approach_distance &gt; 0:
            frame_normal = offset_frame.normal
            frame_normal_scaled = scale_vector(-frame_normal, approach_distance)
            if(flip_offset_plane):
                frame_normal_scaled = scale_vector(-frame_normal, approach_distance)
            new_frame_origin = add_vectors(offset_frame.point, frame_normal_scaled)
            offset_frame = Frame(new_frame_origin, offset_frame.xaxis, offset_frame.yaxis)
        
        return offset_frame
</item>
