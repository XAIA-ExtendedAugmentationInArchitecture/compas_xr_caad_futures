              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
Calculate pickup trajectory of a part.
"""
import math
from ghpythonlib.componentbase import executingcomponent as component
from scriptcontext import sticky as st

#from compas.artists import Artist
from compas.scene import Scene
from compas.geometry import Frame
from compas.geometry import Transformation
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino_plane
from compas_rhino.conversions import mesh_to_compas
from compas_fab.ghpython.components import create_id
from compas_fab.robots import AttachedCollisionMesh
from compas_fab.robots import CollisionMesh
from compas_fab.robots import PlanningScene

#from helpers import get_assembly_sequence

class PlanPartPickupTrajectory(component):
    def RunScript(self, robot, group, max_step, current_config, exit_safe_config, approach_pick_config, approach_place_config, place_config, mesh_to_attach, planner_id, compute):
        self.Message = ""

        
        place_trajectory = None
        move_trajectory = None

        pick_trajectory_frames = []
        place_trajectory_frames = []
        move_trajectory_frames = []

        ###############################################################
        #  ADDED FOR THE PICK TRAJECTORY AND PLANNING
        ###############################################################
        move_to_pick_trajectory = None
        exit_trajectory = None
        exit_trajectory_frames = []
        move_to_pick_trajectory_frames = []
        max_step_cartesian = 0.02

        # Clean scene
        if compute and robot and robot.client and robot.client.is_connected:
            scene = PlanningScene(robot)

        # TODO: ADD COLLISION MESHES

        if not approach_place_config or not place_config or not approach_pick_config:
            self.Message = "No approach &amp; place configs defined"
            return place_trajectory, place_trajectory_frames, move_trajectory, move_trajectory_frames
        else:
            approach_place_config = self.normalize_joint_values_to_pi(approach_place_config)
            place_config = self.normalize_joint_values_to_pi(place_config)
            exit_safe_config = self.normalize_joint_values_to_pi(exit_safe_config)
            current_config = self.normalize_joint_values_to_pi(current_config)

        # Compute Exit trajectory
        if compute and robot and robot.client and robot.client.is_connected:
            #Remove Attached_collision mesh from the end effector 
            scene = PlanningScene(robot)
            scene.remove_attached_collision_mesh("attached_part")
            scene.remove_collision_mesh("attached_part")

            # plan exit trajectory
            max_step = max_step
            exit_frames = [
                       robot.forward_kinematics(c, group, options=dict(solver='model'))
                       for c in (current_config, exit_safe_config)
                     ]

            print (exit_frames)

            exit_trajectory_temp= robot.plan_cartesian_motion(exit_frames,
                                                     start_configuration=current_config,
                                                     group=group,
                                                     options=dict(
                                                         max_step=max_step_cartesian,
    #                                                         attached_collision_meshes=attached_collision_meshes
                                                     ))
            if exit_trajectory_temp.fraction &lt; 1:
                raise Exception("Incomplete cartesian exit trajectory found. Only {:.1f}% of the trajectory could be planned".format(exit_trajectory_temp.fraction * 100))

            # Only assign if fraction is full
            exit_trajectory = exit_trajectory_temp

            if exit_trajectory:
                for c in exit_trajectory.points:
                    frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                    exit_trajectory_frames.append(frame_to_rhino_plane(frame))
    
            # Compute Move to pick trajectory
            if compute and robot and robot.client and robot.client.is_connected:
                planner_id = planner_id or 'TRRT'
    #    
    #                # Attach Mesh to End Effector
    #                mesh_to_attach = mesh_to_compas(mesh_to_attach)
    #                cm = CollisionMesh(mesh_to_attach, "attached_part")
    #                scene.attach_collision_mesh_to_robot_end_effector(cm, group=group)
    
                tolerance_above = self._generate_default_tolerances(robot.get_configurable_joints(group))
                tolerance_below = self._generate_default_tolerances(robot.get_configurable_joints(group))
                goal_constraints = robot.constraints_from_configuration(
                    configuration=approach_pick_config,
                    tolerances_above=tolerance_above,
                    tolerances_below=tolerance_below,
                    group=group
                )
    
                trajectory = robot.plan_motion(goal_constraints,
                                                   start_configuration=exit_safe_config,
                                                   group=group,
                                                   options=dict(
                                                   planner_id=planner_id
                                                   # attached_collision_mesh = [cm]
                                                   ))
                move_to_pick_trajectory = trajectory

        if move_to_pick_trajectory:
            for c in move_to_pick_trajectory.points:
                frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                move_to_pick_trajectory_frames.append(frame_to_rhino_plane(frame))

        # the code following this was the code that existed before.

            max_step = max_step
            frames = [
                       robot.forward_kinematics(c, group, options=dict(solver='model'))
                       for c in (approach_place_config, place_config)
                     ]

            trajectory = robot.plan_cartesian_motion(frames,
                                                     start_configuration=approach_place_config,
                                                     group=group,
                                                     options=dict(
                                                         max_step=max_step_cartesian,
    #                                                         attached_collision_meshes=attached_collision_meshes
                                                     ))
            if trajectory.fraction &lt; 1:
                raise Exception("Incomplete Place cartesian trajectory found. Only {:.1f}% of the trajectory could be planned".format(trajectory.fraction * 100))

            # Only assign if fraction is full
            place_trajectory = trajectory

        if place_trajectory:
            for c in place_trajectory.points:
                frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                place_trajectory_frames.append(frame_to_rhino_plane(frame))

        # Compute MOVE trajectory
        if compute and robot and robot.client and robot.client.is_connected:
            planner_id = planner_id or 'TRRT'

            # Attach Mesh to End Effector
            mesh_to_attach = mesh_to_compas(mesh_to_attach)
            cm = CollisionMesh(mesh_to_attach, "attached_part")
            scene.attach_collision_mesh_to_robot_end_effector(cm, group=group)

            tolerance_above = self._generate_default_tolerances(robot.get_configurable_joints(group))
            tolerance_below = self._generate_default_tolerances(robot.get_configurable_joints(group))
            goal_constraints = robot.constraints_from_configuration(
                configuration=approach_place_config,
                tolerances_above=tolerance_above,
                tolerances_below=tolerance_below,
                group=group
            )

            trajectory = robot.plan_motion(goal_constraints,
                                               start_configuration=approach_pick_config,
                                               group=group,
                                               options=dict(
                                               planner_id=planner_id,
                                               attached_collision_mesh = [cm]
                                               ))

            move_trajectory = trajectory

        if move_trajectory:
            for c in move_trajectory.points:
                frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                move_trajectory_frames.append(frame_to_rhino_plane(frame))

        if place_trajectory and move_trajectory and exit_trajectory and move_to_pick_trajectory:
            self.Message = "Found move and place trajectories ({} points)".format(len(place_trajectory.points) + len(move_trajectory.points) + len(exit_trajectory.points) + len(move_to_pick_trajectory.points))

        return exit_trajectory, exit_trajectory_frames, move_to_pick_trajectory, move_to_pick_trajectory_frames, place_trajectory, place_trajectory_frames, move_trajectory, move_trajectory_frames
#        return place_trajectory, place_trajectory_frames, move_trajectory, move_trajectory_frames

    def _generate_default_tolerances(self, joints):
        DEFAULT_TOLERANCE_METERS = .001
        DEFAULT_TOLERANCE_RADIANS = math.radians(1)

        return [
            DEFAULT_TOLERANCE_METERS if j.is_scalable()
            else DEFAULT_TOLERANCE_RADIANS
            for j in joints
        ]

    def normalize_joint_values_to_pi(self, config):
        for i,v in enumerate(config.joint_values):
            if v&gt;math.pi:
                v-=2*math.pi
            if v&lt;-math.pi:
                v+=2*math.pi
            config.joint_values[i]=v
        return config</item>
