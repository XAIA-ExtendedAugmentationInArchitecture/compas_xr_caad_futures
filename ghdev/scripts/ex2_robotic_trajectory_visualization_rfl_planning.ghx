                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_fab.robots import PlanningScene
from compas_fab.robots import CollisionMesh
from compas_rhino.conversions import mesh_to_compas
from compas.data import json_dump,json_dumps
if robot:
    if add:
        cmesh = mesh_to_compas(mesh)
        scene = PlanningScene(robot)
        scene.remove_collision_mesh("table")
        cm = CollisionMesh(cmesh, "table")
        scene.add_collision_mesh(cm)
</item>
