                    <item name="Description" type_name="gh_string" type_code="10">A group of Grasshopper objects</item>
                    <item name="ID" index="0" type_name="gh_guid" type_code="9">8c09f071-9863-4baa-b53a-bc811a385c16</item>
                    <item name="ID" index="1" type_name="gh_guid" type_code="9">c63bc537-43ae-4b15-b3f8-028693a08c37</item>
