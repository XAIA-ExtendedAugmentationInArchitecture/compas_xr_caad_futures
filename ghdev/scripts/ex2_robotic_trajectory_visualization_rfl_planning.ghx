              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">#if pick_trajectory and place_trajectory and not move_trajectory:
#    pick_trajectory = pick_trajectory.points
#    for item in pick_trajectory:
#        print (item)
#    place_trajectory = place_trajectory.points

from compas_fab.robots import JointTrajectory

if move_trajectory and place_trajectory:
    trajectory = move_trajectory.points + \
                 place_trajectory.points
    place_trajectory = place_trajectory.points
    
    combined_trajectory = JointTrajectory(trajectory)</item>
