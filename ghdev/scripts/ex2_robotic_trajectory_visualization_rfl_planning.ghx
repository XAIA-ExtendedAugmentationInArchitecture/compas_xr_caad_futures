            <chunk name="Object" index="447">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_rhino.conversions import plane_to_compas_frame
from compas.geometry import Transformation, Translation, Vector

if not (assembly and building_plan and frame_to_attach_part and part_height):
    ghenv.Component.Message = "Missing Transformation Information"

else:
    if requested_key:
        ghenv.Component.Message = "Transforming Information for Step {}".format(requested_key)

        #Transform objects for collision meshes &amp; Place Frame
        requested_element_assembly_id = building_plan.steps[requested_key].element_ids[0]
        graph_data = assembly.graph.__data__
        node = graph_data["node"][str(requested_element_assembly_id)]
        part = node["part"]
        part_frame = part.frame
    
        frame_to_attach_part = plane_to_compas_frame(frame_to_attach_part)
        translation = Translation.from_vector(frame_to_attach_part.zaxis*part_height/2)
        frame_translation = Translation.from_vector(part_frame.zaxis*part_height/2)
        transformation = Transformation.from_frame_to_frame(part_frame, frame_to_attach_part)
        part_frame_transformed = part.transformed(transformation)
        part_to_attach = part_frame_transformed.transformed(translation)
        place_frame = part_frame.transformed(frame_translation)
    else:
        ghenv.Component.Message = "No Element has been Requested"</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
