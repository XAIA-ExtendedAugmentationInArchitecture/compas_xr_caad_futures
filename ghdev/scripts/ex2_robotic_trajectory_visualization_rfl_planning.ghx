                    <item name="CodeInput" type_name="gh_string" type_code="10">import collections

options = collections.namedtuple('Options', [
    'xsize',
    'ysize',
    'zsize',
    'xgap',
    'zgap',
])

options.xsize = xsize
options.ysize = ysize
options.zsize = zsize
options.xgap = xgap
options.zgap = zgap

</item>
