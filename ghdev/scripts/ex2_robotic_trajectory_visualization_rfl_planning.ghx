                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_xr.project import ProjectManager
from compas_xr.ghpython.app_settings import AppSettings

if not (config_filepath):
    ghenv.Component.Message = "Missing Config"

elif not (project_name):
    ghenv.Component.Message = "Missing Settings Data"

else:
    app_settings = AppSettings(project_name, storage_folder, z_to_y_remap)
    pm = ProjectManager(config_filepath)
    ghenv.Component.Message = None
    
    if write:
        pm.application_settings_writer(app_settings.project_name, app_settings.storage_folder, app_settings.z_to_y_remap)</item>
