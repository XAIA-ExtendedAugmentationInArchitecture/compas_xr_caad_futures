                      <Y>14</Y>
                    </item>
                    <item name="EditorSize" type_name="gh_drawing_size" type_code="32">
                      <W>1114</W>
                      <H>959</H>
                    </item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
