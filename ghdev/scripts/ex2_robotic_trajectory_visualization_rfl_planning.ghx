                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Transformation, Frame
from compas_rhino.conversions import plane_to_compas_frame


world_origin = Frame.worldXY()

urdf_frame = plane_to_compas_frame(urdf_base_frame)
actual_frame = plane_to_compas_frame(actual_robot_location)

tx = Transformation.from_frame_to_frame(actual_frame, urdf_frame)
inv_tx = tx.inverse() </item>
