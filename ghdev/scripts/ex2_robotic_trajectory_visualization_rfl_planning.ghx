                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_fab.robots import JointTrajectory

if pick_trajectory and place_trajectory and not move_trajectory:
    pick_trajectory = pick_trajectory.points
    for item in pick_trajectory:
        print (item)
    place_trajectory = place_trajectory.points

if exit_trajectory and move_to_pick_trajectory and pick_trajectory and move_trajectory and place_trajectory:
    trajectory = exit_trajectory.points + \
                 move_to_pick_trajectory.points + \
                 pick_trajectory.points + \
                 list(reversed(pick_trajectory.points)) + \
                 move_trajectory.points + \
                 place_trajectory.points
    place_trajectory = place_trajectory.points
    pick_trajectory = pick_trajectory.points
    combined_trajectory = JointTrajectory(trajectory)
    
</item>
