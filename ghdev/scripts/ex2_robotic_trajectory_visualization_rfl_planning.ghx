              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Transformation, Frame
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino_plane


qr_model_frame = plane_to_compas_frame(qr_model_frame)
measured = plane_to_compas_frame(measured)

tx = Transformation.from_frame_to_frame(measured, qr_model_frame)
frame_world = Frame.worldXY()

robot_world_base = frame_world.transformed(tx)
a = frame_to_rhino_plane(robot_world_base)</item>
