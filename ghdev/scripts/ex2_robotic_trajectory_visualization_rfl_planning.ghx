                    <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="UserText" type_name="gh_string" type_code="10">This Section includes a 1 Step process that is used to visualize trajectories in the Rhino Environment. It utilizes existing Compas Fab components to generate custom previews.

NOTE: ALL PLANNING VISUALIZATIONS ARE JUST AN EXAMPLE, AND SHOULD BE CUSTOMIZED FOR THE TRAJECTORY THAT EACH PROJECT WOULD LIKE TO VISUALIZE.</item>
                  </items>
                  <chunks count="2">
                    <chunk name="Attributes">
                      <items count="5">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>1939</X>
                          <Y>3412</Y>
                          <W>1305</W>
                          <H>75</H>
                        </item>
                        <item name="MarginLeft" type_name="gh_int32" type_code="3">0</item>
                        <item name="MarginRight" type_name="gh_int32" type_code="3">0</item>
